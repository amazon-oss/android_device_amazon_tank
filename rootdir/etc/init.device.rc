on post-fs-data
    # Audio
    chmod 0660 /dev/bleremote_audio
    chown system audio /dev/bleremote_audio

    # Bluetooth
    chmod 0660 /dev/ttyMT1
    chown bluetooth bluetooth /dev/ttyMT1
    chmod 0660 /sys/devices/platform/bluetooth_rfkill/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/devices/platform/bluetooth_rfkill/rfkill/rfkill0/state
    start btmac

    # HDMI
    chmod 0664 /dev/hdmitx

on boot
    # Power
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    write /sys/power/wake_lock disablesuspend

# Bluetooth
service btmac /system/bin/init.btmac.sh
    user bluetooth
    group bluetooth
    disabled
    oneshot

# Display
service mdp_server /system/bin/mdp_server
    class main
    user system
    group system graphics

# DRM
service amzn_drmprov /system/bin/amzn_drmprov_check
    class main
    user root
    group system
    oneshot

service drmkey_backup /system/bin/amzn_drmprov_tool --backup
    class main
    user root
    group system
    disabled
    oneshot

on property:sys.amzn_drm.need_backup=1
    start drmkey_backup

# HDMI
service hdmi /system/bin/hdmi
    class main
    user system
    group system net_admin inet
